# 소스별 키. 없는 소스는 건너뛰고 결과에 "확인 불가"로 남긴다.
# OpenDART: https://opendart.fss.or.kr (무료, 일 20,000건)
DART_API_KEY=
# 영국 Companies House는 키 대신 무료 일괄 데이터를 쓴다: python scripts/build_ch_index.py
# SEC EDGAR는 키가 없지만 연락처가 담긴 User-Agent를 요구한다. 예: "fund-reversing-ai you@example.com"
SEC_USER_AGENT=
# GLEIF는 키 불필요.

# 선택: 문서 추출용 LLM. auto | gemini | anthropic | none
TRACER_LLM_PROVIDER=auto
GEMINI_API_KEY=
ANTHROPIC_API_KEY=
